# Compute server (B) only.
[Unit]
Description=FSP bench worker: run B's share of a bench pass posted by production
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fsp
WorkingDirectory=/home/fsp
# Two methods at once (threads sharing the data), 2 model threads each; a second
# method starts only with >= 800 MB headroom under MemoryMax (scripts/bench_worker.py).
Environment=BENCH_PARALLEL=2 BENCH_MEM_RESERVE_MB=800
Environment=MODEL_N_JOBS=2 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 SIGNAL_TRAIN_DAYS=400
# Leave room for the website (Nice keeps it ahead) and the system. The bench runs
# Sunday afternoon ET = night in Beijing, so it never overlaps the China news job.
Nice=10
CPUQuota=360%
MemoryHigh=2800M
MemoryMax=3000M
# Sandbox: the job can only write its own work dir.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/fsp/bench
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ExecStart=/home/fsp/app/deploy/bench_worker.sh
TimeoutStartSec=16h

[Unit]
Description=FSP daily US pipeline (refresh, incremental train, signals)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/.env
Environment=SIGNAL_TRAIN_DAYS=400 MODEL_N_JOBS=2 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
Nice=10
ExecStart=/home/ubuntu/app/deploy/run_pipeline.sh daily
TimeoutStartSec=6h
